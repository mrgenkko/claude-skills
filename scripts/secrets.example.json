{
  "mcp_servers": [
    {
      "name": "gcloud-proyecto-a",
      "type": "gcloud",
      "project": "mi-proyecto-gcp",
      "region": "us-east4",
      "workdir": "/home/TU_USUARIO/mi-proyecto",
      "account": "sa@mi-proyecto-gcp.iam.gserviceaccount.com",
      "key_file": null
    },
    {
      "name": "gcloud-proyecto-b",
      "type": "gcloud",
      "project": "mi-otro-proyecto-gcp",
      "region": "us-east4",
      "workdir": "/home/TU_USUARIO/mi-otro-proyecto",
      "account": "sa@mi-otro-proyecto-gcp.iam.gserviceaccount.com",
      "key_file": "/home/TU_USUARIO/keys/mi-otro-proyecto/sa.json",
      "config_dir": "/home/TU_USUARIO/.config/gcloud-proyecto-b"
    },
    {
      "name": "postgres-mi-bd",
      "type": "postgres",
      "host": "TU_HOST_BD",
      "port": 5432,
      "db": "mi_base_de_datos",
      "user": "mi_usuario",
      "password": "keyring:postgres-mi-bd/password"
    },
    {
      "name": "ssh-mi-servidor",
      "type": "ssh",
      "host": "192.168.1.100",
      "port": 22,
      "user": "ubuntu",
      "key_file": "/home/TU_USUARIO/.ssh/id_rsa",
      "password": null,
      "sudo_password": null,
      "allow_sessions": true,
      "session_idle_timeout": 1800
    },
    {
      "name": "redis-mi-cache",
      "type": "redis",
      "host": "TU_HOST_REDIS",
      "port": 6379,
      "db": 0,
      "password": null,
      "allow_flush": false
    },
    {
      "name": "gh-mi-org",
      "type": "gh",
      "token": "keyring:gh-mi-org/token",
      "owner": "mi-org",
      "allow_write": false
    },
    {
      "name": "obsidian",
      "type": "obsidian",
      "vault_path": "/home/TU_USUARIO/ObsidianVault"
    },
    {
      "name": "focusyn",
      "type": "focusyn",
      "url": "http://localhost:7415/mcp/",
      "agent_key": "keyring:focusyn/agent_key"
    },
    {
      "name": "webprobe",
      "type": "webprobe",
      "browser": "chromium",
      "headless": true,
      "allow_headed": true,
      "max_tabs": 8,
      "tab_idle_timeout": 600,
      "browser_idle_timeout": 1800,
      "timeout_ms": 60000
    },
    {
      "name": "pixelorama",
      "type": "pixelorama",
      "pixelorama_bin": "",
      "max_pixels": 1048576
    },
    {
      "name": "modal-mi-workspace",
      "type": "modal",
      "workspace": "mi-workspace",
      "environment": "main",
      "token_id": "keyring:modal-mi-workspace/token_id",
      "token_secret": "keyring:modal-mi-workspace/token_secret",
      "config_path": "/home/TU_USUARIO/.config/modal/mi-workspace.toml",
      "modal_bin": "",
      "allow_write": false,
      "allow_gpu": false,
      "timeout_ms": 900000
    }
  ]
}
